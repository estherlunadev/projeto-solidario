:root{--bg:#f5f8fc;--surface:#fff;--ink:#182b45;--muted:#68788e;--blue:#a9ccff;--blue-soft:#eaf3ff;--blue-mid:#6e9fe8;--red:#df3942;--line:#dce6f2;--shadow:0 12px 35px rgba(28,55,88,.10);--green:#247a55}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Arial,Helvetica,sans-serif}a{color:inherit}button,input,select,textarea{font:inherit}button,a.btn{cursor:pointer}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}
.header-inner{width:min(1240px,calc(100% - 32px));margin:auto;display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:13px 0}
.brand{text-decoration:none;font-family:Georgia,serif;font-size:24px;color:#24466e;white-space:nowrap}.brand b{color:var(--red)}
nav{display:flex;gap:7px;flex-wrap:wrap;flex:1}nav a{font-size:12px;text-decoration:none;padding:7px 9px;border-radius:8px;color:#415a77}nav a:hover,nav a.active{background:var(--blue-soft);color:#173e70}
.theme{border:1px solid var(--line);background:var(--blue-soft);color:var(--ink);padding:8px 12px;border-radius:9px}
main{padding:30px 0 60px}.screen{display:none;min-height:70vh;animation:fade .25s ease}.screen.active{display:block}@keyframes fade{from{opacity:.4;transform:translateY(5px)}to{opacity:1;transform:none}}
.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:36px;padding:35px 0}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:bold;color:#557ca9}.hero h1{font:700 clamp(34px,5vw,58px)/1.1 Georgia,serif;margin:18px 0}.hero h1 em{color:var(--red)}.hero p{font-size:18px;color:var(--muted);max-width:560px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:10px;padding:12px 18px;text-decoration:none;font-weight:bold}.primary{background:var(--red);color:#fff}.secondary{background:var(--blue-soft);color:#214b7a;border:1px solid #cfe0f5}.illustration{background:linear-gradient(135deg,#eaf3ff,#d9e9ff);border:10px solid white;border-radius:24px;box-shadow:var(--shadow);padding:20px;text-align:center}.illustration img{display:block;width:100%;max-height:390px;object-fit:contain;border-radius:14px}.illustration p{margin:4px 0 0;font:italic 18px Georgia,serif;color:#31577f}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:18px 0 34px}.stat,.card,.panel,.form-card{background:var(--surface);border:1px solid var(--line);border-radius:17px;padding:22px;box-shadow:var(--shadow)}.stat strong{display:block;font:700 30px Georgia,serif;color:#315f91}.stat span{color:var(--muted);font-size:14px}
h2{font:700 32px/1.2 Georgia,serif;margin:8px 0 14px}h3{margin:0 0 8px}.muted{color:var(--muted)}.section-head{margin:8px 0 22px}.section-head p{color:var(--muted);margin:0}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-card{max-width:760px;margin:18px auto}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}label{font-weight:bold;font-size:14px}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #cbd8e7;border-radius:9px;background:var(--surface);color:var(--ink)}textarea{min-height:100px;resize:vertical}input:focus,select:focus,textarea:focus{outline:3px solid #a9ccff66;border-color:var(--blue-mid)}.form-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:18px}.notice{padding:12px 14px;border-radius:10px;background:var(--blue-soft);color:#31577f;font-size:14px;margin:14px 0}
.table-wrap{overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:14px}table{border-collapse:collapse;width:100%;min-width:620px}th,td{text-align:left;padding:13px 15px;border-bottom:1px solid var(--line)}th{background:var(--blue-soft);font-size:13px;color:#34577d}td{font-size:14px}.pill{display:inline-block;padding:4px 9px;border-radius:30px;background:#e4f5ec;color:#247a55;font-size:12px;font-weight:bold}
.item-art{height:125px;border-radius:12px;background:linear-gradient(135deg,#eaf3ff,#d6e7ff);display:grid;place-items:center;font-size:54px;margin-bottom:14px}.card p{color:var(--muted)}.card .btn{margin-top:8px}
footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:13px}.footer-inner{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.toast{position:fixed;right:18px;bottom:18px;z-index:100;background:#176b45;color:#fff;padding:13px 17px;border-radius:11px;box-shadow:var(--shadow);display:none;max-width:calc(100% - 36px)}.toast.error{background:#b42318}
.backtop{position:fixed;right:20px;bottom:80px;border:0;border-radius:50%;width:44px;height:44px;background:var(--red);color:white;font-size:20px;display:none}
body.dark{--bg:#101827;--surface:#172338;--ink:#edf4ff;--muted:#b4c0d0;--blue-soft:#243750;--line:#304158;--shadow:0 12px 35px rgba(0,0,0,.25)}body.dark header{background:rgba(23,35,56,.96)}body.dark .brand{color:#d5e7ff}body.dark nav a{color:#c5d5e8}body.dark .illustration{border-color:#172338}
@media(max-width:800px){.hero,.two{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.header-inner{gap:10px}nav{order:3;flex-basis:100%}.stats{grid-template-columns:1fr}.hero{padding-top:15px}}
@media(max-width:540px){.grid,.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.hero h1{font-size:38px}.wrap{width:min(100% - 24px,1160px)}nav a{font-size:11px;padding:6px}}
